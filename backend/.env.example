PORT=3001
# connection_limit caps each Prisma pool — required so the parallel e2e suites
# (58 app boots x 4 jest workers, each with a BullMQ worker sharing the pool)
# stay under Postgres max_connections (100).
DATABASE_URL=postgresql://ucm:ucm_dev_password@localhost:5432/ucm?schema=public&connection_limit=5
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
ATTENDANCE_TOKEN_SECRET=change_me_attendance
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password
S3_BUCKET=ucm-dev
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM="University Club Platform <no-reply@ucm.local>"
